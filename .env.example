# ════════════════════════════════════════════════════════════════
#  MEDIVORA — Backend Environment Variables
#  Copy this file: cp .env.example .env   then fill in values.
#  NEVER commit .env to git.
# ════════════════════════════════════════════════════════════════

# ── Gemini / Google AI ────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.0-flash

# ── Database ──────────────────────────────────────────────────────
DATABASE_PATH=data/medical_ai.db

# ── Server ────────────────────────────────────────────────────────
PORT=8000
DEBUG=false

# ── Auth ──────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_64_char_hex_secret
JWT_EXPIRY_HOURS=24

# ── CORS — add your Vercel frontend URL ──────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://medivora.vercel.app

# ── Admin setup key (one-time — delete after creating first admin) ──
ADMIN_SETUP_KEY=

# ── PDF / Verification ────────────────────────────────────────────
PDF_OUTPUT_DIR=data/prescriptions
VERIFICATION_BASE_URL=https://your-api.onrender.com/verify

# ── Optional: SMS / WhatsApp (Twilio) ────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# ── Optional: Video Consultations (Daily.co) ─────────────────────
DAILY_API_KEY=

# ── Optional: Observability (Logfire) ────────────────────────────
LOGFIRE_TOKEN=
